#!/bin/sh
#
# spotify-soloist-updater -- download and install the Spotify Soloist build.
#
# Spotify only ships "latest" archives under stable names and requires that end
# users fetch them from their own page, so this script is the only supported way
# to keep the binary fresh on a router. It is careful about one thing in
# particular: the published builds are glibc binaries, so on a musl OpenWrt
# target they cannot run at all. We verify by executing the candidate before
# touching the installed copy.

. /usr/lib/spotify-soloist/common.sh

STAGING_DIR="/tmp/spotify-soloist/staging"
STAGING_ARCHIVE="${STAGING_DIR}/soloist_release.tar.gz"
STAGING_EXTRACT="${STAGING_DIR}/extract"
BACKUP_BIN="/tmp/spotify-soloist/soloist.previous"
DEADMAN_PID="/tmp/spotify-soloist/deadman.pid"

# How long to wait for the new build to come up before rolling back.
DEADMAN_TIMEOUT=90

usage() {
	cat <<'EOF'
Usage: spotify-soloist-updater [options]

  (no option)        Download the current build and install it if valid.
  --force            Install even if the installed build is not near expiry.
  --check            Print status only; exit 0 if the build is healthy.
  --deadman          Internal: scheduled rollback guard.
  --help             This message.
EOF
}

die() {
	log_msg "ERROR: $1" user.err
	exit "${2:-1}"
}

# --- candidate verification ------------------------------------------------

# Returns 0 if the file looks like an ELF for the running architecture.
#
# This is only a pre-check that lets us produce a clearer error than letting the
# kernel fail. `od` is NOT enabled in OpenWrt's default busybox build, so the
# check is skipped when it is missing; verify_runnable() below is the gate that
# actually decides, and it catches a wrong architecture by itself.
verify_elf_arch() {
	local file="$1" machine expect

	command -v od >/dev/null 2>&1 || {
		log_msg "note: od is unavailable, skipping the ELF pre-check" user.debug
		return 0
	}

	# e_machine is a little-endian 16-bit field at offset 18. All the values we
	# care about are below 0x100, so the high byte is always zero and reading the
	# first byte alone is enough.
	machine=$(od -An -tx1 -j18 -N1 "${file}" 2>/dev/null | tr -d ' \n')
	[ -n "$machine" ] || return 0

	case "$(uname -m)" in
		aarch64|arm64) expect="b7" ;;
		armv7l|armv6l|armv7|arm) expect="28" ;;
		x86_64|amd64) expect="3e" ;;
		*) return 0 ;;
	esac

	[ "$machine" = "$expect" ]
}

# Run the candidate binary. This is the real gate: it catches wrong
# architecture, a missing glibc interpreter, and missing libatomic/libgcc_s.
verify_runnable() {
	local file="$1" out rc

	out=$("${file}" --version 2>&1)
	rc=$?

	if [ "$rc" -ne 0 ]; then
		# Distinguish the two failure modes, because they need different fixes
		# and the kernel's message for the second one is actively misleading.
		case "$out" in
			*"Exec format error"*)
				log_msg "candidate is built for a different CPU architecture" user.err
				;;
			*"No such file or directory"*)
				# The file exists, so this means its ELF interpreter does not:
				# a glibc binary on a musl system.
				log_msg "candidate cannot run here: its dynamic loader is missing." user.err
				log_msg "Spotify ships glibc builds and this appears to be a musl system." user.err
				;;
			*)
				log_msg "candidate exited ${rc}: ${out}" user.err
				;;
		esac
		return 1
	fi

	case "$out" in
		soloist\ *) ;;
		*) return 1 ;;
	esac

	# A build that is already expired is not worth installing.
	local epoch days
	epoch=$(echo "$out" | sed -n 's/.* build \([0-9][0-9]*\) .*/\1/p')
	if [ -n "$epoch" ]; then
		days=$(soloist_days_remaining_for_epoch "$epoch")
		if [ "$days" -le 0 ]; then
			log_msg "downloaded build is already expired (${days} days)" user.err
			return 1
		fi
	fi

	echo "$out"
	return 0
}

# Optional pinning: one "<archive-name> <sha256>" per line in /etc/spotify-soloist/sha256.
verify_pinned_hash() {
	local archive="$1"
	[ -s "${SOLOIST_SHA256_FILE}" ] || return 0

	local want
	want=$(sed -n "s/^${archive}[[:space:]]\{1,\}\([0-9a-fA-F]\{64\}\).*/\1/p" \
		"${SOLOIST_SHA256_FILE}" | head -n 1)
	[ -n "$want" ] || return 0

	local got
	got=$(sha256sum "${archive}" 2>/dev/null | cut -d' ' -f1)
	if [ "${got}" != "${want}" ]; then
		log_msg "sha256 mismatch for ${archive} (expected ${want}, got ${got})" user.err
		return 1
	fi

	log_msg "sha256 matches the pinned value for ${archive}"
	return 0
}

# --- installation ---------------------------------------------------------

# Ask procd to stop the daemon, and fall back to a direct kill if the pid is
# still there. `pkill` is NOT in OpenWrt's default busybox build, so the pid
# comes from the runtime file the daemon writes rather than from pkill.
stop_daemon() {
	local pidfile="${SOLOIST_DATA_DIR}/soloist.pid"
	local pid="" i=0

	/etc/init.d/spotify-soloist stop >/dev/null 2>&1
	sleep 1

	# procd may need a moment; poll rather than guessing.
	while [ "$i" -lt 10 ]; do
		pid=$(soloist_running_pid)
		[ -n "$pid" ] || return 0
		sleep 1
		i=$((i + 1))
	done

	# Still alive: give it TERM, then KILL.
	log_msg "daemon pid ${pid} survived stop, killing it" user.warn
	kill "$pid" 2>/dev/null
	i=0
	while [ "$i" -lt 5 ]; do
		kill -0 "$pid" 2>/dev/null || return 0
		sleep 1
		i=$((i + 1))
	done

	kill -9 "$pid" 2>/dev/null
	sleep 1
	rm -f "$pidfile" 2>/dev/null
	return 0
}

start_daemon() {
	/etc/init.d/spotify-soloist start >/dev/null 2>&1
}

daemon_healthy() {
	# Two conditions: the process is up, and it did not immediately exit 10.
	/etc/init.d/spotify-soloist running >/dev/null 2>&1 || return 1

	# A build that expired between download and start would exit 10 at once.
	sleep 3
	/etc/init.d/spotify-soloist running >/dev/null 2>&1
}

install_candidate() {
	local candidate="$1"
	local was_running=0

	/etc/init.d/spotify-soloist running >/dev/null 2>&1 && was_running=1

	stop_daemon

	if [ -f "${SOLOIST_BIN}" ]; then
		cp "${SOLOIST_BIN}" "${BACKUP_BIN}" || log_msg "WARN: could not back up current binary" user.warn
	fi

	# Install to a temporary name in the same directory, then rename, so a
	# crash mid-copy can never leave a truncated /usr/sbin/soloist behind.
	local tmp="${SOLOIST_BIN}.new"
	cp "${candidate}" "${tmp}" || {
		log_msg "ERROR: copy to ${tmp} failed" user.err
		[ "$was_running" = 1 ] && start_daemon
		return 1
	}
	chmod 0755 "${tmp}"
	mv "${tmp}" "${SOLOIST_BIN}" || {
		log_msg "ERROR: rename into place failed" user.err
		[ "$was_running" = 1 ] && start_daemon
		return 1
	}

	soloist_write_meta

	if [ "$was_running" = 1 ]; then
		start_daemon
		if daemon_healthy; then
			log_msg "new build started successfully"
			return 0
		fi

		log_msg "new build did not stay up, rolling back" user.err
		rollback
		return 1
	fi

	return 0
}

rollback() {
	stop_daemon

	if [ -f "${BACKUP_BIN}" ]; then
		cp "${BACKUP_BIN}" "${SOLOIST_BIN}"
		chmod 0755 "${SOLOIST_BIN}"
		log_msg "restored the previous build"
		soloist_write_meta
	fi

	# Keep the service configured; it will retry and log the expiration.
	start_daemon
	return 0
}

# --- deadman --------------------------------------------------------------
#
# A download over a slow link can outlive the LuCI HTTP request that started
# it, leaving the Web UI without a result. The caller schedules a guard: if the
# updater finishes normally the guard is cancelled, otherwise the guard rolls
# the installation back after DEADMAN_TIMEOUT seconds.

schedule_deadman() {
	# Leave a boot-independent record for the operator.
	soloist_write_meta
	date +%s > /tmp/spotify-soloist/update.started

	(
		trap '' TERM INT HUP
		sleep ${DEADMAN_TIMEOUT}
		# Reached only when nobody cancelled us.
		log_msg "update guard fired after ${DEADMAN_TIMEOUT}s, rolling back" user.warn
		rollback
	) &
	echo $! > "${DEADMAN_PID}"
}

cancel_deadman() {
	[ -f "${DEADMAN_PID}" ] || return 0
	local pid
	pid=$(cat "${DEADMAN_PID}" 2>/dev/null)
	[ -n "${pid}" ] && kill "${pid}" 2>/dev/null
	rm -f "${DEADMAN_PID}"
	return 0
}

# --- main -----------------------------------------------------------------

do_update() {
	local force="$1"

	soloist_api_key_present || log_msg "WARN: no API key stored yet; the daemon cannot log in" user.warn

	soloist_take_lock || die "another update is already running" 2

	local url
	url=$(soloist_archive_url) || die "unsupported architecture: $(uname -m)"

	local archive
	archive=$(basename "${url}")

	log_msg "downloading ${url}"

	rm -rf "${STAGING_DIR}"
	mkdir -p "${STAGING_EXTRACT}"

	if ! curl -fLsS --connect-timeout 20 --max-time 600 \
		-o "${STAGING_ARCHIVE}" "${url}"; then
		die "download failed (check DNS, WAN connectivity and clock)"
	fi

	local size
	size=$(wc -c < "${STAGING_ARCHIVE}" 2>/dev/null || echo 0)
	if [ "${size}" -lt 1000000 ]; then
		die "downloaded archive is implausibly small (${size} bytes)"
	fi

	verify_pinned_hash "${archive}" || die "archive failed hash verification"

	if ! tar -xzf "${STAGING_ARCHIVE}" -C "${STAGING_EXTRACT}" soloist 2>/dev/null; then
		# Older archives carry extra files; extract everything then look.
		tar -xzf "${STAGING_ARCHIVE}" -C "${STAGING_EXTRACT}" 2>/dev/null ||
			die "could not extract the archive"
	fi

	if [ ! -f "${STAGING_EXTRACT}/soloist" ]; then
		die "archive does not contain a soloist executable"
	fi

	chmod 0755 "${STAGING_EXTRACT}/soloist"

	verify_elf_arch "${STAGING_EXTRACT}/soloist" ||
		die "archive is not built for $(uname -m)"

	local newver
	newver=$(verify_runnable "${STAGING_EXTRACT}/soloist") || die \
		"the downloaded build cannot run on this device; Spotify Soloist requires a glibc-based (not musl) system with libatomic and libgcc"

	log_msg "candidate verified: ${newver}"

	install_candidate "${STAGING_EXTRACT}/soloist" ||
		die "installation rolled back, the previous build is still in place"

	soloist_prepare_dirs
	soloist_write_meta

	rm -rf "${STAGING_DIR}"

	log_msg "update complete: ${newver}"
	return 0
}

check_only() {
	soloist_install_ready || die "soloist is not installed" 3

	local days
	days=$(soloist_days_remaining)
	soloist_write_meta

	log_msg "installed build: $(soloist_meta_get version)"
	log_msg "days remaining: ${days}"

	[ "$days" -gt 0 ] 2>/dev/null || return 3
	return 0
}

# --- entry ----------------------------------------------------------------

[ -r /usr/lib/spotify-soloist/common.sh ] || {
	echo "spotify-soloist: missing /usr/lib/spotify-soloist/common.sh" >&2
	exit 1
}

ACTION_UPDATE=1
FORCE=0

while [ $# -gt 0 ]; do
	case "$1" in
		--force)
			FORCE=1
			;;
		--check)
			ACTION_UPDATE=0
			;;
		--deadman)
			schedule_deadman
			exit 0
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			usage >&2
			exit 1
			;;
	esac
	shift
done

if [ "$ACTION_UPDATE" = 0 ]; then
	check_only
	exit $?
fi

do_update "$FORCE"
rc=$?

cancel_deadman
exit $rc
