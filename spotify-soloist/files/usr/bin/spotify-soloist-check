#!/bin/sh
#
# spotify-soloist-check -- periodic expiry check, started from cron.
#
# Spotify Soloist builds stop working 90 days after their build date and then
# exit with status 10, so something has to notice before that happens. This
# script is what cron runs; it decides whether to call the updater now.

. /usr/lib/spotify-soloist/common.sh

usage() {
	cat <<'EOF'
Usage: spotify-soloist-check [options]

  (no option)   Check expiry and update if the threshold is reached.
  --days        Print the number of days remaining (may be negative).
  --force       Update now, regardless of the remaining time.
  --install     Install the binary if it is missing, then exit.
  --help        This message.

Exit codes:
  0  nothing to do, or the update succeeded
  1  an update was needed but could not be completed
  2  the service is disabled in the configuration
  3  the binary is missing or expired beyond recovery
EOF
}

log_msg "check started"

config_load spotify-soloist
config_get_bool enabled main enabled 1
config_get_bool auto_update main auto_update 1
config_get threshold main update_threshold 15
config_get_bool notify_only main update_notify_only 0

case "${1:-}" in
	--help|-h)
		usage
		exit 0
		;;
	--days)
		# Machine readable; no logging noise on stdout.
		SOLOIST_QUIET=1
		soloist_days_remaining
		exit 0
		;;
	--install)
		/usr/bin/spotify-soloist-updater
		exit $?
		;;
	--force)
		/usr/bin/spotify-soloist-updater --force
		exit $?
		;;
	"") ;;
	*)
		usage >&2
		exit 1
		;;
esac

if [ "$enabled" != "1" ]; then
	log_msg "service is disabled, nothing to do"
	exit 2
fi

# First run after installation: fetch the binary.
if ! soloist_install_ready; then
	log_msg "no binary installed yet, downloading"
	/usr/bin/spotify-soloist-updater
	exit $?
fi

soloist_write_meta

days=$(soloist_days_remaining)
version=$(soloist_meta_get version)

if [ "$days" -lt 0 ] 2>/dev/null; then
	log_msg "could not determine the build date of ${version}" user.warn
	exit 3
fi

log_msg "installed build expires in ${days} days"

if [ "$days" -le 0 ]; then
	log_msg "build has already expired; the service will not start until it is updated" user.err
	if [ "$auto_update" = "1" ]; then
		/usr/bin/spotify-soloist-updater --force
		exit $?
	fi
	exit 3
fi

if [ "$days" -gt "$threshold" ] 2>/dev/null; then
	log_msg "no update needed (threshold ${threshold} days)"
	exit 0
fi

log_msg "within ${threshold} days of expiry"

if [ "$auto_update" != "1" ]; then
	log_msg "automatic updates are disabled; run the updater by hand" user.warn
	exit 1
fi

if [ "$notify_only" = "1" ]; then
	log_msg "notify-only mode: skipping the download" user.notice
	exit 1
fi

/usr/bin/spotify-soloist-updater
rc=$?

if [ "$rc" = "0" ]; then
	log_msg "update finished, restarting the service if needed" user.notice
	/etc/init.d/spotify-soloist restart >/dev/null 2>&1
fi

exit $rc
